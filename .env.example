# Database
DB_URL=jdbc:postgresql://localhost:5432/logdb
DB_USERNAME=postgres
DB_PASSWORD=replace_me
POSTGRES_DB=logdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me

# API Authentication
APP_USERNAME=admin
APP_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_characters_secret
JWT_EXPIRATION_MINUTES=120

# Optional Redis cache
SPRING_CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ollama
LOG_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me
